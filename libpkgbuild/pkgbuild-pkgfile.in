#!/bin/sh
# Private pkgfile/0 recipe worker for libpkgbuild.
# Legacy inspection remains temporarily for compatibility; snapshot-bound
# execution consumes an engine-materialized copy of one libpkgsource capture.

mode=$1
shift

E_GENERAL=1
E_PKGFILE=2
E_DIR_PERM=3
E_DOWNLOAD=4
E_UNPACK=5
E_MD5=6
E_FOOTPRINT=7
E_BUILD=8
readonly E_GENERAL E_PKGFILE E_DIR_PERM E_DOWNLOAD E_UNPACK E_MD5 E_FOOTPRINT E_BUILD

info()    { echo "=======> $1" >&2; }
warning() { info "WARNING: $1"; }
error()   { info "ERROR: $1"; }
fatal()   { error "$1"; exit "$E_GENERAL"; }

load_pkgfile() {
	pkgfile=$recipe_dir/Pkgfile
	[ -f "$pkgfile" ] || fatal "File '$pkgfile' not found."
	cd "$recipe_dir" || fatal "Cannot enter recipe directory '$recipe_dir'."
	# Intentional: pkgfile/0 recipes are executable POSIX shell.
	# shellcheck disable=SC1090
	. "$pkgfile"
	command -V build 2>/dev/null | grep -qwi function || \
		fatal "Function 'build' not specified in Pkgfile."
}

set_engine_contract() {
	PKGMK_ROOT=$recipe_dir
	PKGMK_SOURCE_DIR=$source_dir
	PKGMK_PACKAGE_DIR=$package_dir
	PKGMK_WORK_DIR=$work_dir
	PKGMK_ARCHIVE_FORMAT=$archive_format
	PKGMK_COMPRESSION_MODE=$compression_mode
	export PKGMK_ROOT PKGMK_SOURCE_DIR PKGMK_PACKAGE_DIR PKGMK_WORK_DIR
	export PKGMK_ARCHIVE_FORMAT PKGMK_COMPRESSION_MODE
}

case $mode in
inspect|run)
	# Transitional compatibility path.  This is the old mutable-directory
	# protocol and will disappear when Engine stops accepting DefinitionRequest.
	recipe_dir=$1
	config_file=$2
	source_dir=$3
	package_dir=$4
	work_dir=$5
	archive_format=$6
	compression_mode=$7

	set_engine_contract
	if [ -f "$recipe_dir/.32bit" ]; then
		PKGMK_ARCH=32
	else
		PKGMK_ARCH=64
	fi
	export PKGMK_ARCH

	load_pkgfile
	if [ -n "$config_file" ]; then
		[ -f "$config_file" ] || fatal "File '$config_file' not found."
		# Intentional compatibility: legacy configuration is executable shell.
		# shellcheck disable=SC1090
		. "$config_file"
	fi

	: "${source:=}"
	: "${PKGMK_ARCHIVE_FORMAT:=gnutar}"
	: "${PKGMK_COMPRESSION_MODE:=gz}"

	[ -n "${name:-}" ] || fatal "Variable 'name' not specified in Pkgfile."
	[ -n "${version:-}" ] || fatal "Variable 'version' not specified in Pkgfile."
	[ -n "${release:-}" ] || fatal "Variable 'release' not specified in Pkgfile."
	[ "$(basename "$recipe_dir")" = "$name" ] || \
		fatal "Variable 'name' does not match package directory name."

	if [ "$mode" = inspect ]; then
		# Match pkgmk's unquoted source iteration.  This interpretation belongs
		# only to the compatibility path; libpkgsource owns it going forward.
		# shellcheck disable=SC2086
		set -- $source
		printf '%s\0' \
			'pkgfile-helper/1' "$name" "$version" "$release" \
			"$PKGMK_ARCHIVE_FORMAT" "$PKGMK_COMPRESSION_MODE" 'build' "$#"
		for source_word do
			printf '%s\0' "$source_word"
		done
		exit 0
	fi

	# Preserve the old run protocol until the C++ engine is rewired.
	set_engine_contract
	SRC=$8
	PKG=$9
	expected_name=${10}
	expected_version=${11}
	expected_release=${12}
	export SRC PKG

	[ "$name" = "$expected_name" ] && \
	[ "$version" = "$expected_version" ] && \
	[ "$release" = "$expected_release" ] || \
		fatal "Pkgfile identity changed after inspection."

	cd "$SRC" || fatal "Cannot enter prepared source directory '$SRC'."
	(set -e -x; build)
	;;
run-captured)
	# Snapshot-bound execution protocol.  The recipe directory is a disposable
	# engine materialization of the immutable source snapshot, not a collection
	# path.  Source facts and policy are supplied by BuildDefinition.
	recipe_dir=$1
	source_dir=$2
	package_dir=$3
	work_dir=$4
	archive_format=$5
	compression_mode=$6
	architecture=$7
	prepared_source_root=$8
	prepared_package_root=$9
	accepted_name=${10}
	accepted_version=${11}
	accepted_release=${12}

	case $architecture in
	native) PKGMK_ARCH=64 ;;
	legacy_32bit) PKGMK_ARCH=32 ;;
	*) fatal "Unsupported accepted build architecture '$architecture'." ;;
	esac
	set_engine_contract

	# Execute only the captured program.  No legacy configuration or source
	# sidecar is inspected here.  Pkgfile assignments may run as recipe code,
	# but they do not become source truth a second time.
	load_pkgfile

	# The captured program is untrusted execution input.  Reassert the complete
	# accepted engine contract after sourcing it instead of comparing three
	# declarations and trusting the rest of the shell state.
	name=$accepted_name
	version=$accepted_version
	release=$accepted_release
	case $architecture in
	native) PKGMK_ARCH=64 ;;
	legacy_32bit) PKGMK_ARCH=32 ;;
	esac
	SRC=$prepared_source_root
	PKG=$prepared_package_root
	set_engine_contract
	export name version release PKGMK_ARCH SRC PKG

	cd "$SRC" || fatal "Cannot enter prepared source directory '$SRC'."
	(set -e -x; build)
	;;
*)
	fatal "Unknown worker mode '$mode'."
	;;
esac
