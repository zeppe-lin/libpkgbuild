#!/bin/sh
# Private pkgfile/0 definition and recipe worker for libpkgbuild.
# This is an execution backend, not the library's semantic model.

mode=$1
recipe_dir=$2
config_file=$3
source_dir=$4
package_dir=$5
work_dir=$6
archive_format=$7
compression_mode=$8

E_GENERAL=1
E_PKGFILE=2
E_DIR_PERM=3
E_DOWNLOAD=4
E_UNPACK=5
E_MD5=6
E_FOOTPRINT=7
E_BUILD=8
readonly E_GENERAL E_PKGFILE E_DIR_PERM E_DOWNLOAD E_UNPACK E_MD5 E_FOOTPRINT E_BUILD

info()    { echo "=======> $1" >&2; }
warning() { info "WARNING: $1"; }
error()   { info "ERROR: $1"; }
fatal()   { error "$1"; exit "$E_GENERAL"; }

PKGMK_ROOT=$recipe_dir
PKGMK_SOURCE_DIR=$source_dir
PKGMK_PACKAGE_DIR=$package_dir
PKGMK_WORK_DIR=$work_dir
PKGMK_ARCHIVE_FORMAT=$archive_format
PKGMK_COMPRESSION_MODE=$compression_mode
export PKGMK_ROOT PKGMK_SOURCE_DIR PKGMK_PACKAGE_DIR PKGMK_WORK_DIR
export PKGMK_ARCHIVE_FORMAT PKGMK_COMPRESSION_MODE

if [ -f "$recipe_dir/.32bit" ]; then
	PKGMK_ARCH=32
else
	PKGMK_ARCH=64
fi
export PKGMK_ARCH

pkgfile=$recipe_dir/Pkgfile
[ -f "$pkgfile" ] || fatal "File '$pkgfile' not found."

# Intentional: Pkgfile and legacy configuration are executable shell.
# shellcheck disable=SC1090
. "$pkgfile"
if [ -n "$config_file" ]; then
	[ -f "$config_file" ] || fatal "File '$config_file' not found."
	# shellcheck disable=SC1090
	. "$config_file"
fi

: "${source:=}"
: "${PKGMK_ARCHIVE_FORMAT:=gnutar}"
: "${PKGMK_COMPRESSION_MODE:=gz}"

[ -n "${name:-}" ] || fatal "Variable 'name' not specified in Pkgfile."
[ -n "${version:-}" ] || fatal "Variable 'version' not specified in Pkgfile."
[ -n "${release:-}" ] || fatal "Variable 'release' not specified in Pkgfile."
command -V build 2>/dev/null | grep -qwi function || \
	fatal "Function 'build' not specified in Pkgfile."
[ "$(basename "$recipe_dir")" = "$name" ] || \
	fatal "Variable 'name' does not match package directory name."

case $mode in
inspect)
	# Match pkgmk's unquoted source iteration: field splitting and pathname
	# expansion happen in the shell after the Pkgfile and configuration have
	# been evaluated.  The private record frames every resulting source word.
	# Intentional: legacy source declarations use shell word splitting.
	# shellcheck disable=SC2086
	set -- $source
	printf '%s\0' \
		'pkgfile-helper/1' "$name" "$version" "$release" \
		"$PKGMK_ARCHIVE_FORMAT" "$PKGMK_COMPRESSION_MODE" 'build' "$#"
	for source_word do
		printf '%s\0' "$source_word"
	done
	;;
run)
	# Configuration supplies build policy, not engine-owned paths.  Reassert
	# the inspected archive identity and the private workspace selected by
	# the engine before executing untrusted recipe code.
	PKGMK_ROOT=$recipe_dir
	PKGMK_SOURCE_DIR=$source_dir
	PKGMK_PACKAGE_DIR=$package_dir
	PKGMK_WORK_DIR=$work_dir
	PKGMK_ARCHIVE_FORMAT=$archive_format
	PKGMK_COMPRESSION_MODE=$compression_mode
	SRC=$9
	PKG=${10}
	expected_name=${11}
	expected_version=${12}
	expected_release=${13}
	export PKGMK_ROOT PKGMK_SOURCE_DIR PKGMK_PACKAGE_DIR PKGMK_WORK_DIR
	export PKGMK_ARCHIVE_FORMAT PKGMK_COMPRESSION_MODE SRC PKG

	[ "$name" = "$expected_name" ] && \
	[ "$version" = "$expected_version" ] && \
	[ "$release" = "$expected_release" ] || \
		fatal "Pkgfile identity changed after inspection."

	cd "$SRC"
	(set -e -x; build)
	;;
*)
	fatal "Unknown worker mode '$mode'."
	;;
esac
